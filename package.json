{
  "name": "@haneoka/altair-plugin-marketplace",
  "version": "0.1.0",
  "description": "Official metadata-only marketplace service for Altair",
  "keywords": [
    "visual-novel",
    "marketplace",
    "plugins",
    "altair"
  ],
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haneoka-gakuen/altair-plugin-marketplace.git"
  },
  "homepage": "https://github.com/haneoka-gakuen/altair-plugin-marketplace#readme",
  "bugs": {
    "url": "https://github.com/haneoka-gakuen/altair-plugin-marketplace/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "SECURITY.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:package": "node scripts/verify-package.mjs",
    "check": "pnpm run typecheck && pnpm run build && pnpm run verify:package",
    "prepack": "pnpm run check"
  },
  "peerDependencies": {
    "@haneoka/altair": "^0.1.0",
    "@haneoka/vega": "^0.1.0",
    "@haneoka/vega-protocol": "^0.1.0"
  },
  "devDependencies": {
    "@haneoka/altair": "^0.1.0",
    "@haneoka/vega": "^0.1.0",
    "@haneoka/vega-protocol": "^0.1.0",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@11.14.0",
  "altair": {
    "pluginApi": 2,
    "kind": "service",
    "capabilities": [
      "services"
    ],
    "permissions": [
      "network:http"
    ],
    "targets": [
      "web",
      "pwa",
      "electron",
      "tauri",
      "android",
      "ios"
    ]
  }
}
